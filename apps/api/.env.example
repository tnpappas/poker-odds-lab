# Copy to .env and fill in. Without DATABASE_URL the API runs with an
# in-memory store (data resets on restart), which is fine for local development.
# In production (NODE_ENV=production) the API refuses to start unless every
# variable marked REQUIRED is set. See src/config.ts.

# --- Database (Neon Postgres) --- REQUIRED in production
DATABASE_URL=

# --- Auth (Clerk) --- REQUIRED in production
# Without CLERK_SECRET_KEY the API runs in dev-auth mode and trusts the
# x-user-id header (hard-disabled in production).
CLERK_SECRET_KEY=
# Signing secret for the Clerk user webhook (Clerk dashboard > Webhooks).
CLERK_WEBHOOK_SECRET=

# --- Payments (PayPal Subscriptions) --- REQUIRED in production
# Client ID / Secret from the REST app at developer.paypal.com (Apps & Credentials).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# 'live' or 'sandbox' (defaults to live). Use sandbox for staging.
PAYPAL_ENV=live
# Webhook ID from the app's Webhooks section; used to verify signatures.
PAYPAL_WEBHOOK_ID=
# Billing plan ids (P-...) from PayPal > Subscriptions > Subscription plans.
PAYPAL_MONTHLY_PLAN_ID=
PAYPAL_ANNUAL_PLAN_ID=

# --- App --- REQUIRED in production
# CORS allowlist, comma-separated. The first entry is where PayPal returns buyers.
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development

# --- Recommended in production (logged as a warning when missing)
# Comma-separated owner emails: get Pro without paying, can use /admin.
OWNER_EMAILS=
# Sentry error tracking DSN for the API (project poker-logic-lab-api).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# GoHighLevel: tags buyers as "customer" to trigger the book-delivery workflow.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_CUSTOMER_TAG=customer
