{
  "name": "poker-odds-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=packages/poker-engine",
    "test:api": "npm run test --workspace=apps/api",
    "test:all": "npm run test && npm run test:api",
    "lint": "eslint .",
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "build": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/api",
    "check": "npm run lint && npm run typecheck && npm run test:all && npm run build",
    "audit:prod": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.70.0"
  }
}
